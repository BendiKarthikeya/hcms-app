.fits-chatbot {
    position: fixed;
    right: 24px;
    bottom: 110px;
    z-index: 2100;
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
}

.fits-chatbot__launcher {
    width: 60px;
    height: 60px;
    border: none;
    border-radius: 999px;
    background: linear-gradient(135deg, #103f91, #1e88e5);
    color: #fff;
    font-size: 24px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 12px 24px rgba(16, 63, 145, 0.28);
}

.fits-chatbot__panel {
    position: absolute;
    right: 0;
    bottom: 76px;
    width: min(420px, calc(100vw - 32px));
    height: 620px;
    max-height: calc(100vh - 140px);
    display: none;
    overflow: hidden;
    border: 1px solid rgba(16, 63, 145, 0.12);
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 24px 48px rgba(17, 24, 39, 0.18);
}

.fits-chatbot--open .fits-chatbot__panel {
    display: flex;
    flex-direction: column;
}

.fits-chatbot__header {
    padding: 16px 18px;
    background: linear-gradient(135deg, #0b3a86, #1565c0);
    color: #fff;
}

.fits-chatbot__title {
    font-size: 16px;
    font-weight: 700;
}

.fits-chatbot__subtitle {
    margin-top: 4px;
    font-size: 12px;
    opacity: 0.88;
}

.fits-chatbot__messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    background: #f6f8fc;
}

.fits-chatbot__message {
    margin-bottom: 14px;
}

.fits-chatbot__bubble {
    max-width: 88%;
    padding: 12px 14px;
    border-radius: 16px;
    line-height: 1.45;
    font-size: 14px;
    white-space: pre-wrap;
    word-break: break-word;
}

.fits-chatbot__message--assistant .fits-chatbot__bubble {
    justify-content: flex-start;
    background: #fff;
    color: #1f2937;
    border: 1px solid #e5e7eb;
    border-top-left-radius: 6px;
}

.fits-chatbot__message--user {
    justify-content: flex-end;
    display: flex;
    justify-content: flex-end;
}

.fits-chatbot__message--user .fits-chatbot__bubble {
    background: #0b3a86;
    color: #fff;
    border-top-right-radius: 6px;
}

.fits-chatbot__links {
    margin-top: 10px;
    display: grid;
    gap: 8px;
}

.fits-chatbot__link {
    display: block;
    padding: 10px 12px;
    border-radius: 12px;
    text-decoration: none;
    background: #eef5ff;
    border: 1px solid #d7e6ff;
    color: #0b3a86;
}

.fits-chatbot__link-title {
    display: block;
    font-size: 13px;
    font-weight: 700;
}

.fits-chatbot__link-meta {
    display: block;
    margin-top: 2px;
    font-size: 12px;
    color: #355891;
}

.fits-chatbot__composer {
    padding: 14px;
    border-top: 1px solid #e5e7eb;
    background: #fff;
}

.fits-chatbot__quick-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 10px;
}

.fits-chatbot__quick-action {
    border: 1px solid #cfe0ff;
    background: #f8fbff;
    color: #0b3a86;
    border-radius: 999px;
    padding: 7px 10px;
    font-size: 12px;
    cursor: pointer;
}

.fits-chatbot__input-row {
    display: flex;
    gap: 8px;
    align-items: flex-end;
}

.fits-chatbot__textarea {
    flex: 1;
    min-height: 52px;
    max-height: 140px;
    resize: vertical;
    border: 1px solid #cbd5e1;
    border-radius: 14px;
    padding: 12px 14px;
    font-size: 14px;
    line-height: 1.4;
    outline: none;
}

.fits-chatbot__textarea:focus {
    border-color: #1e88e5;
    box-shadow: 0 0 0 3px rgba(30, 136, 229, 0.14);
}

.fits-chatbot__send {
    border: none;
    border-radius: 14px;
    padding: 12px 16px;
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    background: #1565c0;
    cursor: pointer;
}

.fits-chatbot__send[disabled] {
    opacity: 0.65;
    cursor: default;
}

.fits-chatbot__status {
    margin-top: 8px;
    font-size: 12px;
    color: #64748b;
}

@media (max-width: 720px) {
    .fits-chatbot {
        right: 12px;
        bottom: 84px;
    }

    .fits-chatbot__panel {
        right: -4px;
        width: min(100vw - 16px, 390px);
        height: min(72vh, 560px);
    }
}

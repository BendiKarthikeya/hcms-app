DJANGO_ENV=development
DJANGO_SETTINGS_MODULE=fits.settings

DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,*.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://example.com
TIME_ZONE=Asia/Muscat

# PostgreSQL Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/hcms

# Trial mode (Feature #53)
TRIAL_MODE=False
TRIAL_START_DATE=
TRIAL_DURATION_DAYS=30
TRIAL_DEMO_DATA_FIXTURE=django_data.json

# ============================================
# FEATURE 1: PIP WORKFLOW (Traditional)
# ============================================
PIP_WORKFLOW_ENABLED=True
PIP_AUTO_TRIGGER_REVIEW=True
PIP_DAY_30_TRIGGER=True
PIP_DAY_60_TRIGGER=True
PIP_DAY_90_TRIGGER=True

# ============================================
# FEATURE 2: AI CV SCREENING (DeepSeek)
# ============================================
CV_SCREENING_AI_ENABLED=True
OPENROUTER_API_KEY=your-openrouter-api-key
# Get API key from: https://openrouter.io
# Setup: Sign up → Create API key → Add in .env
DEEPSEEK_MODEL=deepseek/deepseek-chat
CV_SCREENING_THRESHOLD=70
CV_AUTO_SHORTLIST_ENABLED=True

# ============================================
# FEATURE 3: GRATUITY/EOSB CALCULATION
# ============================================
GRATUITY_ENABLED=True
GRATUITY_MAX_AMOUNT=50000.00
GRATUITY_MIN_SERVICE_MONTHS=12
GRATUITY_APPLY_TAX=True
GRATUITY_TAX_RATE=0.20
# Royal Decree 35/2003 rates
GRATUITY_RATE_0_3_YEARS=0.50
GRATUITY_RATE_4_5_YEARS=0.75
GRATUITY_RATE_6_PLUS_YEARS=1.00

# ============================================
# FEATURE 4: WPS FILE GENERATION (CBM)
# ============================================
WPS_ENABLED=True
WPS_CBM_FORMAT=True
WPS_EMPLOYER_CODE=
WPS_ESTABLISHMENT_CODE=
WPS_FILE_VALIDATION=True
WPS_AUTO_GENERATE=False
# Central Bank of Oman WPS Configuration

# ============================================
# FEATURE 5: GL INTEGRATION (Journal Entries)
# ============================================
GL_INTEGRATION_ENABLED=True
GL_AUTO_CREATE_JOURNALS=True
GL_REQUIRE_APPROVAL=True
GL_ENABLE_COST_CENTERS=True
GL_DEFAULT_COMPANY_ACCOUNT=1101
GL_SALARY_EXPENSE_ACCOUNT=5101
GL_ALLOWANCE_EXPENSE_ACCOUNT=5102
GL_DEDUCTION_PAYABLE_ACCOUNT=2101
GL_TAX_PAYABLE_ACCOUNT=2102

# ============================================
# FEATURE 6: ICBS PAYROLL DISBURSEMENT
# ============================================
ICBS_ENABLED=True
ICBS_BANK_CODE=
ICBS_BANK_NAME=
ICBS_API_ENDPOINT=
ICBS_API_KEY=
ICBS_API_SECRET=
ICBS_COMPANY_IBAN=
ICBS_TIMEOUT_SECONDS=30
ICBS_RETRY_ATTEMPTS=3
ICBS_DAILY_LIMIT=1000000.00
ICBS_MONTHLY_LIMIT=10000000.00
ICBS_ISLAMIC_COMPLIANCE=True
ICBS_PROFIT_SHARING_RATE=0.00

# ============================================
# FEATURE 7: LINKEDIN LEARNING INTEGRATION
# ============================================
LINKEDIN_LEARNING_ENABLED=True
LINKEDIN_LEARNING_CLIENT_ID=
LINKEDIN_LEARNING_CLIENT_SECRET=
LINKEDIN_LEARNING_REDIRECT_URI=http://localhost:8000/recruitment/linkedin-callback/
LINKEDIN_LEARNING_AUTH_ENDPOINT=https://www.linkedin.com/oauth/v2/authorization
LINKEDIN_LEARNING_TOKEN_ENDPOINT=https://www.linkedin.com/oauth/v2/accessToken
LINKEDIN_LEARNING_API_ENDPOINT=https://api.linkedin.com/v2
LINKEDIN_LEARNING_AUTO_ENROLL=False
LINKEDIN_LEARNING_SCOPES=r_liteprofile,r_emailaddress,w_member_social

# ============================================
# FEATURE 7B: UDEMY INTEGRATION
# ============================================
UDEMY_ENABLED=True
UDEMY_API_KEY=
UDEMY_API_ENDPOINT=https://www.udemy.com/api-2.0
UDEMY_ORGANIZATION_ID=
UDEMY_AUTO_ENROLL=False
UDEMY_AUTO_ASSIGN_PATHS=True
UDEMY_COMPLETION_REQUIREMENT=80

# ============================================
# FEATURE 8: SIEM AUDIT LOG EXPORT
# ============================================
SIEM_ENABLED=True
SIEM_TYPE=splunk
# Options: splunk, elastic, sumo, datadog, arista, generic
SIEM_NAME=Splunk Enterprise

# Splunk Configuration
SPLUNK_API_ENDPOINT=https://your-splunk-instance:8088/services/collector
SPLUNK_API_TOKEN=
# Setup: Splunk → Settings → Data Inputs → HTTP Event Collector

# Elastic Configuration (alternative)
ELASTIC_API_ENDPOINT=https://your-elastic-instance:9200
ELASTIC_API_KEY=
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=

# Sumo Logic Configuration (alternative)
SUMO_API_ENDPOINT=https://endpoint.sumologic.com/receiver/v1/http
SUMO_API_TOKEN=

# Datadog Configuration (alternative)
DATADOG_API_KEY=
DATADOG_HOSTNAME=
DATADOG_SITE=datadoghq.com

# Generic Syslog (fallback)
SIEM_SYSLOG_HOST=192.168.1.100
SIEM_SYSLOG_PORT=514
SIEM_SYSLOG_PROTOCOL=udp

# SIEM Settings
SIEM_EXPORT_FORMAT=json
# Options: cef, json, syslog, csv
SIEM_AUTO_EXPORT=True
SIEM_EXPORT_INTERVAL_MINUTES=60
SIEM_EXPORT_USER_LOGIN_LOGOUT=True
SIEM_EXPORT_DATA_ACCESS=True
SIEM_EXPORT_DATA_MODIFICATION=True
SIEM_EXPORT_PERMISSION_CHANGES=True
SIEM_EXPORT_ADMIN_ACTIONS=True
SIEM_EXPORT_SECURITY_EVENTS=True

# ============================================
# EXISTING FEATURES
# ============================================

# AWS S3 Configuration (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION=us-east-1

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Slack Integration (Optional)
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# Biometric Integration
BIOMETRIC_ENABLED=False
ZK_TECO_DEVICE_IP=
ZK_TECO_DEVICE_PORT=

# LDAP Configuration
LDAP_ENABLED=False
LDAP_SERVER=ldap.example.com
LDAP_PORT=389
LDAP_BASE_DN=dc=example,dc=com

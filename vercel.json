{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "django",
      "entrypoint": "fits/wsgi.py"
    },
    "ionicons": {
      "root": "static/images/ionicons",
      "buildCommand": "echo 'no build'",
      "installCommand": "echo 'no install'"
    }
  },
  "rewrites": [
    {
      "source": "/static/images/ionicons/(.*)",
      "destination": {
        "service": "ionicons"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
